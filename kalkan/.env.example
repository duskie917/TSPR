# --- Обязательно для Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# --- ИИ-анализ (Claude). Без ключа бот работает только по базе схем ---
ANTHROPIC_API_KEY=
# Модель и глубина рассуждений (low | medium | high). low — быстро и дешево, достаточно для классификации.
KALKAN_MODEL=claude-opus-5-5
KALKAN_EFFORT=low
# KALKAN_AI=off  # выключить ИИ даже при наличии ключа

# --- Проверка ссылок и файлов (необязательно, оба сервиса бесплатны) ---
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# https://www.virustotal.com/gui/my-apikey (проверяем только хэш файла, сам файл не отправляем)
VIRUSTOTAL_API_KEY=

# --- Хранилище и HTTP ---
KALKAN_DB=data/kalkan.db
PORT=8080
# KALKAN_API=off   # выключить B2B API
# KALKAN_DEMO=off  # выключить демо-страницу на /

# Telegram ID администраторов через запятую (команда /stats)
ADMIN_IDS=

# --- White-label для партнера (банк / оператор) ---
BRAND_NAME=Калкан
BRAND_PARTNER=
BRAND_HOTLINE=
