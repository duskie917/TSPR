# Where the pitch form POSTs. Leave empty to fall back to an email (mailto:) submission.
# Example (Formspree): https://formspree.io/f/xxxxxxx
PUBLIC_PITCH_FORM_ENDPOINT=
# Editorial inbox used for the mailto fallback and contact links.
PUBLIC_EDITORIAL_EMAIL=editors@tianshanpolicy.org
# Deployment (set by CI). SITE is the full origin; BASE_PATH is the sub-path, e.g. /TSPR for GitHub Pages.
SITE=https://example.com
BASE_PATH=/
