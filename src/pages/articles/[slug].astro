---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticles, relatedArticles, type Article } from '../../lib/utils';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, related: relatedArticles(article, all) } }));
}
interface Props { article: Article; related: Article[] }
const { article, related } = Astro.props;
const { Content } = await render(article);
---
<ArticleLayout article={article} related={related}><Content /></ArticleLayout>
