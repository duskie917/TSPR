---
import { countryLabel, topicLabel } from '../data/taxonomy';
import { url } from '../lib/utils';
interface Props { topics: string[]; countries?: string[] }
const { topics, countries = [] } = Astro.props;
---
<ul class="tags" aria-label="Tags">
  {topics.map((t) => <li><a class="tag" href={url(`/topics/${t}`)}>{topicLabel(t)}</a></li>)}
  {countries.map((c) => <li><a class="tag country" href={url(`/countries/${c}`)}>{countryLabel(c)}</a></li>)}
</ul>
